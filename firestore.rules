rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == "nr.nizami99@gmail.com"; }

    function isValidArticle(data) {
        return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
               (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
               data.content is string && data.content.size() <= 60000 &&
               data.category in ['Haid', 'Nifas', 'Istihadloh', 'Umum'] &&
               data.authorId is string &&
               data.articleNumber is number;
    }

    match /articles/{articleId} {
      allow list, get: if true;
      allow create: if isAdmin() && isValidArticle(request.resource.data);
      allow update: if isAdmin() && isValidArticle(request.resource.data);
      allow delete: if isAdmin();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
